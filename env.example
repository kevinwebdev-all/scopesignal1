# Copy this file to .env.local for local development.
# Never commit .env.local or paste real keys into any tracked file.
# On Vercel, add GEMINI_API_KEY under Project Settings → Environment Variables.

# Required. Get a key from Google AI Studio.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional. Defaults to a Flash-class model in src/lib/env.ts.
GEMINI_MODEL=gemini-2.5-flash
